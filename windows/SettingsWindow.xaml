<Window
    x:Class="RivetHost.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- PRODUCT-SPEC §8 + §2a: the app preferences (language, theme,
         auto-check-updates) and the 新任务/数据 groups in the
         platform-conventional surface. Rows follow the Windows 11
         settings-card shape: caption left, control right. Brushes resolve
         after InitializeComponent via code (same cold-launch ThemeResource
         caveat MainWindow documents); captions are wired in
         ApplyAppLanguage. -->
    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="480" Margin="20,16,20,20"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Spacing="4">
                <Grid Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageCaption" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="180"
                              VerticalAlignment="Center"
                              SelectionChanged="OnLanguageSelected" />
                </Grid>
                <Grid Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ThemeCaption" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="180"
                              VerticalAlignment="Center"
                              SelectionChanged="OnThemeSelected" />
                </Grid>
                <Grid Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AutoCheckCaption" VerticalAlignment="Center" />
                    <!-- OnContent/OffContent cleared in code: the caption lives
                         in the row's TextBlock, Windows-11 settings-row style. -->
                    <ToggleSwitch x:Name="AutoCheckSwitch" Grid.Column="1"
                                  VerticalAlignment="Center" MinWidth="0"
                                  Toggled="OnAutoCheckToggled" />
                </Grid>

                <!-- §2a 新任务 group: default list + recorded global
                     quick-add accelerator (display-only, never registered). -->
                <TextBlock x:Name="NewTasksGroupHeader" Margin="0,12,0,4"
                           FontSize="14" FontWeight="SemiBold" />
                <Grid MinHeight="56" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DefaultListCaption" />
                        <TextBlock x:Name="DefaultListHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="DefaultListComboBox" Grid.Column="1"
                              Width="200" VerticalAlignment="Center"
                              SelectionChanged="OnDefaultListSelected" />
                </Grid>
                <Grid MinHeight="72" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="QuickAddCaption" />
                        <TextBlock x:Name="QuickAddHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="QuickAddRecorderButton"
                                AutomationProperties.AutomationId="settings-quick-add-recorder"
                                MinWidth="160" HorizontalAlignment="Stretch"
                                Click="OnQuickAddRecorderClicked" />
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Right">
                            <Button x:Name="QuickAddResetButton" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnQuickAddResetClicked" />
                            <Button x:Name="QuickAddClearButton" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnQuickAddClearClicked" />
                        </StackPanel>
                        <TextBlock x:Name="QuickAddHintText" FontSize="11"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- §2a 数据 group: current database + lifecycle actions. -->
                <TextBlock x:Name="DataGroupHeader" Margin="0,12,0,4"
                           FontSize="14" FontWeight="SemiBold" />
                <Grid MinHeight="68" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="DbCurrentPanel" Spacing="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="settings-db-current">
                        <TextBlock x:Name="DbCurrentCaption" />
                        <TextBlock x:Name="DbCurrentNameText" FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DbCurrentPathText" FontSize="11"
                                   TextTrimming="CharacterEllipsis" MaxWidth="280"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DbRevealButton" Grid.Column="1"
                            Tag="reveal"
                            VerticalAlignment="Center" MinWidth="120"
                            Click="OnDataActionClicked" />
                </Grid>
                <Grid MinHeight="56" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DbMigrateCaption" />
                        <TextBlock x:Name="DbMigrateHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DbMigrateButton" Grid.Column="1"
                            Tag="migrate"
                            AutomationProperties.AutomationId="settings-db-migrate"
                            VerticalAlignment="Center" MinWidth="120"
                            Click="OnDataActionClicked" />
                </Grid>
                <Grid MinHeight="56" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DbOpenCaption" />
                        <TextBlock x:Name="DbOpenHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DbOpenButton" Grid.Column="1"
                            Tag="open"
                            AutomationProperties.AutomationId="settings-db-open"
                            VerticalAlignment="Center" MinWidth="120"
                            Click="OnDataActionClicked" />
                </Grid>
                <Grid MinHeight="56" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DbCreateCaption" />
                        <TextBlock x:Name="DbCreateHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DbCreateButton" Grid.Column="1"
                            Tag="create"
                            AutomationProperties.AutomationId="settings-db-create"
                            VerticalAlignment="Center" MinWidth="120"
                            Click="OnDataActionClicked" />
                </Grid>
                <Grid MinHeight="56" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DbExportCaption" />
                        <TextBlock x:Name="DbExportHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DbExportButton" Grid.Column="1"
                            Tag="export"
                            AutomationProperties.AutomationId="settings-db-export"
                            VerticalAlignment="Center" MinWidth="120"
                            Click="OnDataActionClicked" />
                </Grid>
                <Grid MinHeight="56" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DbRestoreCaption" />
                        <TextBlock x:Name="DbRestoreHelpText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DbRestoreButton" Grid.Column="1"
                            Tag="restore"
                            AutomationProperties.AutomationId="settings-db-restore"
                            VerticalAlignment="Center" MinWidth="120"
                            Click="OnDataActionClicked" />
                </Grid>
                <TextBlock x:Name="DataNoteText" FontSize="12" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DataFeedbackText" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="settings-data-feedback" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
